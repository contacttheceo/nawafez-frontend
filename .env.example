NEXT_PUBLIC_API_URL=https://yourdomain.freehostia.com/api
NEXT_PUBLIC_APP_NAME=نوافذ
NEXT_PUBLIC_APP_URL=https://nawafez.vercel.app

# ── Web Push (VAPID) ────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for backend → /api/push/send authentication.
# Generate with: openssl rand -hex 32
PUSH_INTERNAL_SECRET=
